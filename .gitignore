# ビルド成果物・作業ファイル
shiori/obj/
shiori/dist/
studio/obj/
ukagaka-studio.exe
ukagaka-studio.json
parts.json
webview-data/
projects/
output/
.vs/

# git bundle などの手元バックアップ（リポジトリには入れない）
*.bundle

# テストが作業用に置くもの
# YAYA のテスト（shiori/test/）が置くものと、YAYA が書く変数の保存
shiori/test/*/*/yaya.dll
shiori/test/*/*/yaya_base/
shiori/test/yaya/work/
**/yaya_variable.cfg
# 名前を一つずつ書くと、テスト用の exe を増やしたとき書き忘れます
studio/test/*_host.exe
studio/test/render_out/

# 配布用のまとめ（-Release で作る）
/dist/
obj/

# IDE・手元の設定
.idea/
.claude/settings.local.json
