              "type": "surface",
              "who": 0,
              "id": 1
            },
            {
              "type": "say",
              "who": 0,
              "text": "You came back again. I'm so happy.",
              "nl": 1
            }
          ],
          "else": [
            {
              "type": "say",
              "who": 0,
              "text": "Welcome back.",
              "nl": 1
            }
          ]
        },
        {
          "type": "say",
          "who": 0,
          "nl": 1,
          "text": {
            "type": "join",
            "a": "That makes ",
            "b": {
              "type": "join",
              "a": {
                "type": "var",
                "name": "visits"
              },
              "b": " visits."
            }
          }
        }
      ]
