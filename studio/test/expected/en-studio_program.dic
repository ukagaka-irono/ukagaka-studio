//==============================================================================
// Dictionary exported from blocks by Ukagaka Studio (studio_program.dic).
// It is rewritten on every export, so do not edit it by hand; put hand-written code in another dictionary.
// The Studio.* functions the blocks use are in studio_runtime.dic.
//==============================================================================

//------------------------------------------------------------------------------
// ghost info, settings, the list of scripts and initial values of variables
//------------------------------------------------------------------------------
Studio.Program.Init : void
{
	Studio.meta.name = 'New Ghost'
	Studio.meta.sakuraName = 'Sakura'
	Studio.meta.lang = 'en'
	Studio.set.interval = 180
	Studio.set.enabled = 1
	Studio.set.noRepeat = 0
	Studio.Def('e_boot', 'Studio.Script.e_boot', 'event', 'OnBoot', '', '', 1.0, 0, '', (-1), '', '', 0)
}

//------------------------------------------------------------------------------
