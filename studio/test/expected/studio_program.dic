//------------------------------------------------------------------------------
// かたまり
//------------------------------------------------------------------------------

// OnBoot  (s_boot)
Studio.Script.s_boot : void
{
	Studio.Say(0, 'おはよう。', 1)
}

// OnNadeNade  (s_head)
Studio.Script.s_head : void
{
	Studio.Say(0, 'えへへ。', 1)
}

// OnCommunicate  (s_comm)
Studio.Script.s_comm : void
{
	Studio.Say(0, 'みかんだ。', 1)
}

// OnBoot  (s_mixed)
Studio.Script.s_mixed : void
{
	Studio.Say(0, 'しぼり込みなし。', 1)
}

// ランダムトーク「ひとりごと」  (s_talk)
Studio.Script.s_talk : void
{
	Studio.Say(0, 'ひまだなあ。', 1)
}

// ランダムトーク「つかわない」（無効）  (s_off)
Studio.Script.s_off : void
{
	Studio.Say(0, 'でない。', 1)
}

// トーク「こたえる」  (s_func)
Studio.Script.s_func : void
{
	Studio.Say(0, 'はい。', 1)
}

