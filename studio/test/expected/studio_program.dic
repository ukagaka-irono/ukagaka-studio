//==============================================================================
// 伺かスタジオが、ブロックから書き出した辞書です（studio_program.dic）。
// 書き出すたびに作りなおすので、手で直さないでください。手で書くものは、べつの辞書に。
// ブロックが使う Studio.〜 の関数は、studio_runtime.dic にあります。
//==============================================================================

//------------------------------------------------------------------------------
// ゴーストの情報・設定・かたまりの一覧・変数の初期値
//------------------------------------------------------------------------------
Studio.Program.Init : void
{
	Studio.meta.name = '書き出しテスト'
	Studio.meta.sakuraName = 'なしこ'
	Studio.meta.lang = ''
	Studio.set.interval = 120
	Studio.set.enabled = 1
	Studio.set.noRepeat = 3
	Studio.Def('s_boot', 'Studio.Script.s_boot', 'event', 'OnBoot', '', '', 1.0, 0, '', (-1), '', '', 0)
	Studio.Def('s_head', 'Studio.Script.s_head', 'event', 'OnNadeNade', '', '', 1.0, 0, 'Head', 0, '', '', 0)
	Studio.Def('s_comm', 'Studio.Script.s_comm', 'event', 'OnCommunicate', '', '', 1.0, 0, '', (-1), 'みかん', 'ねえ', 0)
	Studio.Def('s_mixed', 'Studio.Script.s_mixed', 'event', 'OnBoot', '', '', 1.0, 0, '', (-1), '', '', 0)
	Studio.Def('s_talk', 'Studio.Script.s_talk', 'talk', '', 'ひとりごと', '', 3.0, 0, '', (-1), '', '', 0)
	Studio.Def('s_off', 'Studio.Script.s_off', 'talk', '', 'つかわない', '', 1.0, 0, '', (-1), '', '', 1)
	Studio.Def('s_func', 'Studio.Script.s_func', 'function', '', 'こたえる', '', 1.0, 0, '', (-1), '', '', 0)
	Studio.InitVar('好感度', 5.0)
	Studio.InitVar('こたえ', '')
}

